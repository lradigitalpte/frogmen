# NestJS API. Copy to .env for local development only.
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Web app (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://frog:frog@localhost:5432/frog1

# Apply pending SQL migrations on API boot (set false to disable)
AUTO_MIGRATE=true

# Better Auth (generate production value with: openssl rand -base64 48)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# AWS S3 (same pattern as frog / Aureus)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Frogmen

# Email (SMTP alternative; takes precedence over Resend when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Defaults
DEFAULT_CURRENCY=USD

# Comma-separated emails with cross-tenant platform admin access
# (list/delete organizations across all tenants)
PLATFORM_ADMIN_EMAILS=
