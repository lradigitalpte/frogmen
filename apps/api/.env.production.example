# Public deployment URLs
NODE_ENV=production
# Railway injects PORT automatically. API_PORT is only a local/VPS fallback.
API_PORT=3001
API_URL=https://api.example.com
WEB_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com

# Secrets: configure on the API host, never commit real values
DATABASE_URL=postgresql://frogmendash_user:password@host:port/frogmendash_db?sslmode=require
BETTER_AUTH_SECRET=generate-at-least-48-random-bytes
AUTO_MIGRATE=false

# Railway pre-deploy migrations use the Postgres service admin URL, while the
# running API keeps DATABASE_URL restricted to frogmendash_user.
MIGRATION_DATABASE_URL=postgresql://admin:password@internal-host:5432/railway
MIGRATION_DATABASE_NAME=frogmendash_db

# Resend
RESEND_API_KEY=re_replace_me
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME=Frogmen

# S3 / S3-compatible object storage
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=replace_me
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

DEFAULT_CURRENCY=USD
